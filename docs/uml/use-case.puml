@startuml
left to right direction
actor "Visitante" as Visitor
actor "Organização" as Org
actor "Administrador" as Admin
actor "Autoridade confiável" as Authority

rectangle "Data Space MVP" {
  usecase "Consultar catálogo de organizações" as Catalog
  usecase "Cadastrar organização" as Register
  usecase "Pré-cadastrar API e política de uso" as RegisterApi
  usecase "Entrar com e-mail e senha" as Login
  usecase "Aprovar ou rejeitar cadastro" as Approve
  usecase "Emitir DID e VC de um ano" as Issue
  usecase "Validar DID e VC" as Validate
  usecase "Contratar plano" as Subscribe
  usecase "Consultar dados básicos" as Basic
  usecase "Consultar dados premium" as Premium
  usecase "Registrar requisição" as LogRequest
  usecase "Calcular cobrança" as Bill
  usecase "Consultar consumo e cobrança" as Usage
}

Visitor --> Catalog
Visitor --> Register
Org --> Catalog
Org --> Login
Org --> Subscribe
Org --> Basic
Org --> Premium
Org --> Usage
Admin --> Login
Admin --> Approve
Authority --> Validate

Register .> RegisterApi : <<extend>>
Approve .> Issue : <<include>>
Login .> Validate : <<include>>
Subscribe .> Validate : <<include>>
Basic .> Validate : <<include>>
Premium .> Validate : <<include>>
Basic .> LogRequest : <<include>>
Premium .> LogRequest : <<include>>
LogRequest .> Bill : <<include>>
@enduml
